PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local: mongodb://127.0.0.1:27017/<database_name>
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/your_database_name

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Initial Seed Credentials (Optional overrides for npm run seed:users)
INITIAL_ADMIN_NAME="Main Admin"
INITIAL_ADMIN_EMAIL=admin@minicrm.com
INITIAL_ADMIN_PASSWORD=AdminPassword123!

INITIAL_EMPLOYEE_NAME="Sales Employee"
INITIAL_EMPLOYEE_EMAIL=employee@minicrm.com
INITIAL_EMPLOYEE_PASSWORD=EmployeePassword123!

