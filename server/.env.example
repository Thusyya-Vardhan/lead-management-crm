PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local: mongodb://127.0.0.1:27017/<database_name>
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/your_database_name

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

INITIAL_OWNER_NAME=Your Name
INITIAL_OWNER_EMAIL=owner@example.com
INITIAL_OWNER_PASSWORD=choose_a_strong_password
